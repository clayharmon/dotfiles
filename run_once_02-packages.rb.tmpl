#!/usr/bin/env ruby
# Step 2: Install CLI tools and applications.
# Every helper is idempotent, so re-running after a change is safe.

def run(cmd)
  puts "=> #{cmd}"
  system(cmd) || abort("Failed: #{cmd}")
end

def installed?(bin)
  system("command -v #{bin} >/dev/null 2>&1")
end

def brew(*pkgs)
  run "brew install #{pkgs.join(" ")}"
end

def cask(*pkgs)
  pkgs.each do |pkg|
    system("brew list --cask #{pkg} >/dev/null 2>&1") || run("brew install --cask #{pkg}")
  end
end

# Third-party taps need `brew trust` on Homebrew 4.7+. Older brews lack the
# subcommand, so a failure there is ignored.
def tap(name)
  run "brew tap #{name}"
  system("brew trust #{name} >/dev/null 2>&1")
end

def pacman(*pkgs)
  run "sudo pacman -S --needed --noconfirm #{pkgs.join(" ")}"
end

def dnf(*pkgs)
  run "sudo dnf install -y #{pkgs.join(" ")}"
end

# Herdr: agent multiplexer. Homebrew core on macOS, install script elsewhere.
def herdr_install_script
  return if installed?("herdr")
  run "curl -fsSL https://herdr.dev/install.sh | sh"
end

# Claude Code: native installer, replaces the deprecated npm package.
def claude_code
  return if installed?("claude")
  run "curl -fsSL https://claude.ai/install.sh | bash"
end

{{ if eq .chezmoi.os "darwin" -}}
cli_tools = %w[
  neovim fish starship eza bat fd ripgrep
  zoxide atuin git-delta sd xh dust fzf jq
  lazygit gh aichat glow tree-sitter tree-sitter-cli
  herdr age
]

apps = %w[
  kitty firefox@developer-edition
  karabiner-elements hammerspoon docker bitwarden spotify
  font-jetbrains-mono-nerd-font
]

puts "Installing CLI tools..."
brew(*cli_tools)

puts "Installing apps..."
cask(*apps)

puts "Installing AeroSpace (tiling WM), sketchybar, borders..."
tap "nikitabobko/tap"
cask "aerospace"
tap "FelixKratz/formulae"
brew "sketchybar", "borders"

claude_code

{{ else if eq .chezmoi.os "linux" -}}
def yay(*pkgs)
  run "yay -S --needed --noconfirm #{pkgs.join(" ")}"
end

def cargo_install(*pkgs)
  pkgs.each { |pkg| run "cargo install #{pkg}" }
end

if installed?("pacman")
  packages = %w[
    base-devel git
    neovim fish starship eza bat fd ripgrep
    zoxide atuin git-delta sd xh dust fzf jq
    lazygit docker chromium github-cli aichat
    kitty age ttf-jetbrains-mono-nerd
  ]
  puts "Installing packages (Arch)..."
  pacman(*packages)

  unless installed?("yay")
    puts "Installing yay..."
    run "git clone https://aur.archlinux.org/yay.git /tmp/yay && cd /tmp/yay && makepkg -si --noconfirm && rm -rf /tmp/yay"
  end

  puts "Installing AUR packages..."
  yay("spotify", "firefox-developer-edition")

elsif installed?("dnf")
  # Packages available in default Fedora repos. gcc/make: treesitter parsers.
  repo_packages = %w[
    gcc make git
    neovim fish bat fd-find ripgrep
    zoxide atuin git-delta du-dust fzf jq
    gh chromium kitty age jetbrains-mono-fonts-all
  ]
  puts "Installing repo packages (Fedora)..."
  dnf(*repo_packages)

  puts "Enabling Copr repos..."
  run "sudo dnf copr enable -y atim/starship"
  run "sudo dnf copr enable -y dejan/lazygit"

  puts "Installing Copr packages..."
  dnf("starship", "lazygit")

  puts "Installing Docker CE..."
  run "sudo dnf config-manager addrepo --from-repofile=https://download.docker.com/linux/fedora/docker-ce.repo"
  dnf("docker-ce", "docker-ce-cli", "containerd.io", "docker-buildx-plugin", "docker-compose-plugin")

  puts "Installing Spotify..."
  run "sudo dnf config-manager --add-repo=https://negativo17.org/repos/fedora-spotify.repo"
  dnf("spotify-client")

  puts "Installing Firefox Developer Edition..."
  run "sudo dnf copr enable -y the4runner/firefox-dev"
  dnf("firefox-developer-edition")

  # Not packaged for Fedora. eza and sd left the repos in F42.
  puts "Installing cargo packages (eza, sd, xh, aichat)..."
  cargo_install("eza", "sd", "xh", "aichat")
end

herdr_install_script
claude_code

{{ end -}}
puts "Packages installed!"

# ~/.config/kitty/kitty.conf
# Overrides only. `kitty --debug-config` prints the effective config, and
# `kitten choose-fonts` picks fonts. Reload a running kitty with
# `kill -SIGUSR1 (pgrep -x kitty)` or ctrl+cmd+,

# Font
font_family JetBrains Mono
font_size 16.0

# Cursor and scrollback
cursor_shape block
cursor_blink_interval 0.5
scrollback_lines 10000

# URLs
url_color #8ae9fc
url_style curly
detect_urls yes

# Clipboard and bell
copy_on_select yes
enable_audio_bell no

# Window. herdr owns tabs and splits, so kitty's tab bar stays hidden.
window_padding_width 4
{{ if eq .chezmoi.os "darwin" -}}
hide_window_decorations titlebar-only
{{- else -}}
hide_window_decorations yes
{{- end }}
tab_bar_style hidden
confirm_os_window_close 0
background_opacity 0.8
background_blur 20
dynamic_background_opacity yes
include ./theme.conf

# Shell
shell_integration enabled
macos_option_as_alt yes
macos_quit_when_last_window_closed yes

# Keys
kitty_mod super
map kitty_mod+e launch nvim .

# Chords that belong to herdr (see ~/.config/herdr/config.toml).
# no_op unmaps the key in kitty and passes it to the program running inside.
map cmd+enter       no_op
map cmd+shift+enter no_op
map cmd+z           no_op
map cmd+d           no_op
map cmd+r           no_op
map cmd+n           no_op
map cmd+t           no_op
map cmd+h           no_op
map cmd+j           no_op
map cmd+k           no_op
map cmd+l           no_op
map cmd+g           no_op
map cmd+shift+e     no_op
map cmd+shift+r     no_op
map cmd+1           no_op
map cmd+2           no_op
map cmd+3           no_op
map cmd+4           no_op
map cmd+5           no_op
map cmd+6           no_op
map cmd+7           no_op
map cmd+8           no_op
map cmd+9           no_op

#!/bin/bash
# sketchybar config. Reload with: sketchybar --reload
# Scripts run under launchd, which does not put Homebrew on PATH.
export PATH="/opt/homebrew/bin:$PATH"

# Dracula
BACKGROUND=0xff282a36
CURRENT_LINE=0xff44475a
FOREGROUND=0xfff8f8f2
COMMENT=0xff6272a4
GREEN=0xff50fa7b
PURPLE=0xffbd93f9
RED=0xffff5555

PLUGIN_DIR="$CONFIG_DIR/plugins"
FONT="JetBrainsMono Nerd Font"

##### Bar #####
# height=36 is not reserved by sketchybar. AeroSpace reserves it through
# gaps.outer.top in aerospace.toml (44 on monitors without a notch).
sketchybar --bar \
  position=top \
  height=36 \
  color=$BACKGROUND \
  border_width=0 \
  shadow=off \
  margin=0 \
  y_offset=0 \
  padding_left=10 \
  padding_right=10 \
  topmost=window \
  sticky=on \
  font_smoothing=on

##### Defaults #####
default=(
  icon.font="$FONT:Bold:16.0"
  label.font="$FONT:Medium:14.0"
  icon.color=$FOREGROUND
  label.color=$FOREGROUND
  icon.padding_left=6
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=6
  padding_left=2
  padding_right=2
)
sketchybar --default "${default[@]}"

##### AeroSpace workspaces #####
# All nine items exist from startup. plugins/aerospace.sh decides what is drawn:
# 6-9 and the separator show when a second monitor is connected or the
# workspace has windows. display_change re-runs it when a monitor is plugged in.
sketchybar --add event aerospace_workspace_change

add_space() {
  sketchybar --add item "space.$1" left \
    --set "space.$1" \
      background.color=$CURRENT_LINE \
      background.corner_radius=5 \
      background.height=24 \
      background.drawing=off \
      icon.drawing=off \
      label="$1" \
      label.color=$COMMENT \
      label.font="$FONT:Bold:14.0" \
      label.padding_left=8 \
      label.padding_right=8 \
      click_script="aerospace workspace $1"
}

for sid in 1 2 3 4 5; do add_space "$sid"; done

sketchybar --add item separator left \
  --set separator \
    icon="│" \
    icon.color=$COMMENT \
    icon.font="$FONT:Bold:16.0" \
    icon.padding_left=4 \
    icon.padding_right=4 \
    label.drawing=off \
    background.drawing=off \
    drawing=off

for sid in 6 7 8 9; do add_space "$sid"; done

sketchybar --add item space_trigger left \
  --subscribe space_trigger aerospace_workspace_change front_app_switched display_change \
  --set space_trigger \
    drawing=off \
    script="$PLUGIN_DIR/aerospace.sh"

##### Right side #####

sketchybar --add item clock right \
  --set clock \
    icon="" \
    icon.color=$PURPLE \
    label.color=$FOREGROUND \
    update_freq=10 \
    script="$PLUGIN_DIR/clock.sh"

sketchybar --add item battery right \
  --set battery \
    icon.color=$GREEN \
    label.color=$FOREGROUND \
    update_freq=120 \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

# Herdr agents: "waiting/total". Red when one needs an approval or an answer.
sketchybar --add item herdr right \
  --set herdr \
    icon="󰚩" \
    icon.color=$COMMENT \
    label.color=$COMMENT \
    update_freq=5 \
    script="$PLUGIN_DIR/herdr.sh" \
  --subscribe herdr system_woke
{{ if .work }}
# PR Monitor (pending review requests; click opens the popover)
sketchybar --add item pr_monitor right \
  --set pr_monitor \
    icon="" \
    icon.color=$COMMENT \
    label.drawing=off \
    update_freq=120 \
    script="$PLUGIN_DIR/pr_monitor.sh" \
    click_script="open -g prmonitor://toggle" \
  --subscribe pr_monitor system_woke
{{ end }}
# Hammerspoon launcher
sketchybar --add item search right \
  --set search \
    icon="/" \
    icon.color=$PURPLE \
    icon.font="$FONT:Bold:18.0" \
    label.drawing=off \
    click_script="open -g hammerspoon://launcher"

##### Run every script once #####
sketchybar --update

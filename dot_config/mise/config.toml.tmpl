[settings]
{{- if eq .chezmoi.os "darwin" }}
# Tool paths stay at the front of PATH even after fish_add_path runs.
activate_aggressive = true
idiomatic_version_file_enable_tools = ["node", "python", "ruby"]

[settings.ruby]
compile = false
{{- else }}
idiomatic_version_file_enable_tools = ["ruby", "node"]
{{- end }}

[tools]
node = "lts"
{{- if eq .chezmoi.os "darwin" }}
python = "3.12"
ruby = "3.4"
{{- else }}
# Python comes from uv on Linux; mise only provides uv itself.
ruby = "3.4.8"
uv = "latest"
{{- end }}

[hooks]
# ruby-lsp is installed outside project bundles (it composes its own), so it has
# to be reinstalled for each new Ruby. --no-document dodges an rdoc 7/8 conflict
# in the mise Ruby that makes `gem install` exit 1 while still installing.
postinstall = "command -v gem >/dev/null && { gem list -i ruby-lsp >/dev/null 2>&1 || gem install ruby-lsp --no-document; }"

#!/usr/bin/env bash
set -euo pipefail

conf="${XDG_CONFIG_HOME:-$HOME/.config}/backup"
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

set -a
. "$conf/env"
set +a

sources=()
while IFS= read -r line; do
  [ -n "$line" ] || continue
  if [ -e "$HOME/$line" ]; then
    sources+=("$HOME/$line")
  else
    echo "backup: skipping missing $HOME/$line" >&2
  fi
done < "$conf/paths"

case "${1:-run}" in
  dry)
    restic backup --dry-run --exclude-file "$conf/excludes" --exclude-caches "${sources[@]}"
    ;;
  run)
    # restic exits 3 when a snapshot was saved but some file could not be read.
    # Keep pruning in that case, and still report 3 so the log shows it.
    status=0
    restic backup --exclude-file "$conf/excludes" --exclude-caches --tag "$(hostname -s)" "${sources[@]}" || status=$?
    if [ "$status" -ne 0 ] && [ "$status" -ne 3 ]; then
      exit "$status"
    fi
    restic forget --keep-daily 30 --keep-weekly 26 --keep-monthly 24 --prune
    exit "$status"
    ;;
  *)
    restic "$@"
    ;;
esac

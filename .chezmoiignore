# macOS-only
.chezmoiscripts/darwin/**
.config/aerospace/
.config/borders/
.config/sketchybar/
.config/karabiner/
.config/herdr/
.config/herdr-app/
.config/atuin/
.config/starship.toml
.config/fish/functions/pipaste.fish
.config/fish/functions/secrets.fish
.hammerspoon/
.claude/CLAUDE.md
.gitconfig
{{- end }}

{{- if ne .chezmoi.os "linux" }}
# Linux-only (Arch + Hyprland)
.config/hypr/
.config/waybar/
.config/mako/
.config/fuzzel/
.config/gdb/
.config/containers/
.config/pacman/
.config/tmux/

#!/bin/bash
# Step 5: Firefox Developer Edition — policies + user preferences
# policies.json: auto-install extensions, disable telemetry/sponsored stuff
# user.js: about:config preferences (UI, new tab, dark mode, etc.)

set -e

# ── policies.json ─────────────────────────────────────────────────
{{ if eq .chezmoi.os "darwin" -}}
POLICY_DIR="/Library/Application Support/Mozilla/policies"
{{ else if eq .chezmoi.os "linux" -}}
POLICY_DIR="/etc/firefox/policies"
{{ end -}}

echo "Installing Firefox policies..."
sudo mkdir -p "$POLICY_DIR"
sudo tee "$POLICY_DIR/policies.json" > /dev/null << 'POLICY'
{
  "policies": {
    "ExtensionSettings": {
      "uBlock0@raymondhill.net": {
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi",
        "installation_mode": "normal_installed"
      },
      "addon@darkreader.org": {
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/darkreader/latest.xpi",
        "installation_mode": "normal_installed"
      },
      "{446900e4-71c2-419f-a6a7-df9c091e268b}": {
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/bitwarden-password-manager/latest.xpi",
        "installation_mode": "normal_installed"
      }
    },
    "DisableTelemetry": true,
    "DisablePocket": true,
    "DisableFirefoxStudies": true,
    "DontCheckDefaultBrowser": true,
    "NoDefaultBookmarks": true,
    "OfferToSaveLogins": false
  }
}
POLICY

# ── user.js ───────────────────────────────────────────────────────
{{ if eq .chezmoi.os "darwin" -}}
FF_DIR="$HOME/Library/Application Support/Firefox"
[ -d "/Applications/Firefox Developer Edition.app" ] && FF_INSTALLED=1
{{ else if eq .chezmoi.os "linux" -}}
FF_DIR="$HOME/.mozilla/firefox"
(command -v firefox-developer-edition || command -v firefox-dev) >/dev/null && FF_INSTALLED=1
{{ end -}}

# installs.ini names the profile each install actually launches. The profile
# *named* dev-edition-default in profiles.ini can be a stale one left behind
# by a profile reset or the profile manager.
PROFILE_REL=$(grep -h '^Default=.*dev-edition-default' "$FF_DIR/installs.ini" 2>/dev/null | head -1 | cut -d= -f2-)
if [ -z "$PROFILE_REL" ]; then
  PROFILE_REL=$(grep -A2 'Name=dev-edition-default' "$FF_DIR/profiles.ini" 2>/dev/null | grep 'Path=' | head -1 | cut -d= -f2-)
fi
case "$PROFILE_REL" in
  /*) PROFILE_DIR="$PROFILE_REL" ;;
  ?*) PROFILE_DIR="$FF_DIR/$PROFILE_REL" ;;
  *)  PROFILE_DIR="" ;;
esac

# Fall back to any dev-edition profile. macOS keeps them under Profiles/.
if [ ! -d "$PROFILE_DIR" ]; then
  PROFILE_DIR=$(find "$FF_DIR" "$FF_DIR/Profiles" -maxdepth 1 -name "*.dev-edition-default*" -type d 2>/dev/null | head -1)
fi

if [ ! -d "$PROFILE_DIR" ]; then
  if [ -z "$FF_INSTALLED" ]; then
    echo "Firefox Developer Edition is not installed, skipping user.js"
    exit 0
  fi
  # Exit non-zero so chezmoi does not mark this run_once script as done and
  # runs it again on the next `chezmoi apply`.
  echo "Firefox Developer Edition has no profile yet." >&2
  echo "Open it once, quit it, then run: chezmoi apply" >&2
  exit 1
fi

echo "Installing user.js to $PROFILE_DIR..."
cat > "$PROFILE_DIR/user.js" << 'USERJS'
// Managed by chezmoi — manual edits will be overwritten

// ── Homepage & new tab ───────────────────────────────────────────
user_pref("browser.startup.homepage", "https://start.duckduckgo.com/");
user_pref("browser.newtabpage.enabled", false);

// ── Dark theme ───────────────────────────────────────────────────
user_pref("browser.theme.content-theme", 0);
user_pref("browser.theme.toolbar-theme", 0);
user_pref("layout.css.prefers-color-scheme.content-override", 0);

// ── Disable sponsored/suggested content ──────────────────────────
user_pref("browser.newtabpage.activity-stream.showSponsored", false);
user_pref("browser.newtabpage.activity-stream.showSponsoredCheckboxes", false);
user_pref("browser.newtabpage.activity-stream.showSponsoredTopSites", false);
user_pref("browser.newtabpage.activity-stream.feeds.section.topstories", false);
user_pref("browser.newtabpage.activity-stream.feeds.topsites", false);
user_pref("browser.newtabpage.activity-stream.showSearch", false);
user_pref("browser.newtabpage.activity-stream.showWeather", false);
user_pref("browser.newtabpage.activity-stream.asrouter.userprefs.cfr.addons", false);
user_pref("browser.newtabpage.activity-stream.asrouter.userprefs.cfr.features", false);
user_pref("browser.urlbar.suggest.quicksuggest.all", false);
user_pref("browser.urlbar.suggest.quicksuggest.nonsponsored", false);
user_pref("browser.urlbar.suggest.quicksuggest.sponsored", false);
user_pref("browser.urlbar.suggest.recentsearches", false);
user_pref("browser.urlbar.shortcuts.actions", false);

// ── Privacy ──────────────────────────────────────────────────────
user_pref("signon.rememberSignons", false);

// ── UI cleanup ───────────────────────────────────────────────────
user_pref("browser.tabs.hoverPreview.showThumbnails", false);
user_pref("browser.tabs.groups.smart.userEnabled", false);
user_pref("sidebar.visibility", "hide-sidebar");
USERJS

echo "Firefox setup complete! Restart Firefox Developer Edition to load user.js and the policies."
